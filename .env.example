# Образец переменных окружения.
# Скопируйте в .env (файл .env в .gitignore) и при необходимости измените значения.

# Параметры MySQL (используются docker-compose для контейнера db и приложения)
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=blog
MYSQL_ROOT_PASSWORD=root

# Подключение приложения к БД (читаются в config/config.php; в docker-compose
# передаются из MYSQL_* выше)
DB_HOST=db
DB_PORT=3306
DB_NAME=blog
DB_USER=blog
DB_PASS=blog

# Режим отладки: true — показать трейс исключений, false — аккуратные 404/500
APP_DEBUG=false

# Параметры сидера (bin/seed.php). CLI-аргументы имеют приоритет:
#   docker compose run --rm app php bin/seed.php --categories=50 --articles-min=20 --articles-max=40
SEED_CATEGORIES=50
SEED_ARTICLES_MIN=30
SEED_ARTICLES_MAX=90